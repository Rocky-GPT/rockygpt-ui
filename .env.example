# The brain service.
BRAIN_URL=http://127.0.0.1:8000

# Campus-data service used by server routes and pages.
DATA_URL=http://127.0.0.1:8100


# Server-side credential for development-only brain administration routes.
ADMIN_API_TOKEN=replace-with-a-long-random-secret

# Shared key used to HMAC source network addresses and sign the pseudonymous
# client key passed to the brain. Use the same value in UI and brain. Production
# requires at least 32 characters (for example, `openssl rand -hex 32`). Never
# expose this value to the browser. Without it, local limiting still works with
# an ephemeral per-process key, but the brain receives no client identity.
ABUSE_HASH_KEY=replace-me

# The deployment proxy must replace client-supplied CF-Connecting-IP,
# X-Real-IP, and X-Forwarded-For headers before they reach Next.js. The current
# limiter is per process; use a shared atomic store before horizontally scaling.
