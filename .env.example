# The brain service.
BRAIN_URL=http://127.0.0.1:8000

# Optional access token for a protected environment; must match the Brain.
STAGING_SERVICE_TOKEN=

# UI key used to HMAC source network addresses for per-process rate limiting.
# Production requires at least 32 characters (for example, `openssl rand -hex 32`).
# Never expose this value to the browser. Local development can use an ephemeral
# key. The restarted Brain ignores legacy client-identity signature headers.
ABUSE_HASH_KEY=replace-me

# The deployment proxy must replace client-supplied CF-Connecting-IP,
# X-Real-IP, and X-Forwarded-For headers before they reach Next.js. The current
# limiter is per process; use a shared atomic store before horizontally scaling.
